<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 只用来下那一次声学模型。剪辑本身完全离线。 -->
    <!--
      largeHeap：整段音频必须一直在内存里 —— 自适应阈值按 2 秒块统计、
      跨块要连续，嵌入也要按 1 秒窗扫全片，两个都没法分块。
      12 分钟 32kHz float 就是 93MB，默认堆（这台模拟器 201MB）算上余量
      只够 11 分钟，而一位真实用户的素材正好 12 分钟，当场 OOM。
      largeHeap 通常不推荐，但媒体编辑正是它存在的理由。
      它**不是免死金牌**：时长上限仍然按实际拿到的堆算，
      见 Rerank.maxSafeSeconds —— 堆小的机器照样会被提前拦下，
      只是拦的位置由这台机器自己决定，而不是所有人共用一个写死的数。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      前台服务：处理期间把进程钉在前台档。实测切到后台后 oom_score_adj
      从 0 跳到 900（「缓存应用」档，内存一紧就是第一批被杀，且被杀时
      不抛异常、没有任何提示）。详见 WorkService 的注释。
      MEDIA_PROCESSING 是 API 34 起要求的类型声明，语义就是「转码媒体」。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!--
      通知权限（API 33 起）。**不主动要** —— 前台服务不给通知权限照样跑，
      只是那条通知用户看不见；为了一条纯功能性的通知去弹权限框，
      在第一次使用时打断用户，不划算。系统会在合适的时候自己提示。
    -->
    <application
        android:label="Pipo"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Pipo"
        android:allowBackup="false"
        android:largeHeap="true">
        <activity android:name=".MainActivity" android:exported="true"
                  android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".WorkService"
                 android:exported="false"
                 android:foregroundServiceType="mediaProcessing" />
    </application>
</manifest>
