<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标的前景：一台摄像机，镜头就是那颗球。

  为什么是「合并」而不是「相机上方放一个球」：
  两个物体在启动图标上会互相挤。自适应图标的画布是 108×108，但启动器
  只显示中心的 72×72，再套圆形/方圆/水滴遮罩，**关键内容必须收在
  中心 66 以内**。渲染到 48dp 实测过：相机加一个悬在上方的球，
  球缩成一个点，相机的取景器还会被圆切平。

  合并之后只有一个物体，可以画得更大：球在正中、最亮、面积最大，
  48dp 下依然认得出是球，同时相机的轮廓说明了「这是个录像工具」。
  一个形状承担两层含义。

  为什么不是球拍：球拍在小尺寸上会糊成一个色块，而圆形在任何尺寸下
  都认得出来。上一版是「球 + 运动轨迹」，渲染出来轨迹读起来像个柄，
  整体像球拍或棒棒糖 —— 那不是想说的意思。

  所有元素都收在中心 (54,54) 半径 36 之内，任何遮罩形状都不会切到。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 机身 -->
    <path
        android:fillColor="#FFB067"
        android:pathData="M28,38 L61,38 A7,7 0 0 1 68,45 L68,65 A7,7 0 0 1 61,72 L28,72 A7,7 0 0 1 21,65 L21,45 A7,7 0 0 1 28,38 Z" />

    <!-- 取景器。收在 x=84 以内，圆形遮罩切不到 -->
    <path
        android:fillColor="#FFB067"
        android:pathData="M68,49 L84,40 L84,70 L68,61 Z" />

    <!-- 镜头 = 球。整个图标里最大最亮的一块，视线先落在这里 -->
    <path
        android:fillColor="#FFF6EFE6"
        android:pathData="M44,55 m-13.5,0 a13.5,13.5 0 1,0 27,0 a13.5,13.5 0 1,0 -27,0" />

    <!-- 高光：让它读成一个球体而不是一个圆孔 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M39.5,50.5 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
</vector>
