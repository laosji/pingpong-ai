<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 只用来给 Activity 一个无标题栏的壳；配色全在 Compose 里做。
         引 View 体系的 material components 库只为拿一个主题不值得 ——
         那会为一个空壳多打进来几百 KB。 -->
    <style name="Theme.Pipo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
